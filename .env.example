# ==============================================================================
# InWaster Environment Configuration Template
# Duplicate this file to .env.local for Next.js or .env for local deployments
# ==============================================================================

# Node / Deployment Environment
NODE_ENV=development
PORT=3000

# SQLite Persistence Path
# On persistent hosts, path defaults to ./QRBase.db
# On Vercel serverless, the runtime automatically stages SQLite to /tmp/QRBase.db
DATABASE_PATH=./QRBase.db

# Cryptographic Session & JWT Secret Key
# Replace with a high-entropy 256-bit secret in production environments
SECRET_KEY=inwaster_secret_token_key_academic_demo_2026_xyz987

# Hardware Node Authentication Token
# Pre-shared symmetric token configured in firmware/esp32_smart_bin/config.h
DEVICE_API_KEY=inwaster_hardware_token_secure_9921_vit

# Ephemeral QR Token Lifetime (seconds)
QR_TOKEN_TTL_SECONDS=90

# Capacity Utilization Thresholds (%)
BIN_FULL_THRESHOLD=90.0
BIN_WARNING_THRESHOLD=75.0
